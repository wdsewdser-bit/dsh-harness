@@ -0,0 +1,138 @@
+import { z } from "zod";
+import { StagehandClientCreateConfigSchema } from "@browserbasehq/stagehand";
+
+export const stagehandModelSchema = z.object({
+	modelName: z.string().trim().min(1),
+	apiKey: z.string().trim().min(1).optional(),
+	apiKeyEnv: z.string().regex(/^[A-Z_][A-Z0-9_]*$/).optional(),
+	headers: z.record(z.string(), z.string()).optional(),
+	baseURL: z.url().refine((value) => {
+		const url = new URL(value);
+		return !url.username && !url.password && !url.search && !url.hash &&
+			(url.protocol === "https:" || (url.protocol === "http:" && ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname)));
+	}, "Anthropic baseURL must use HTTPS or loopback HTTP, without credentials/query/hash").optional(),
+	maxTokens: z.number().int().min(1).max(32768).default(4096),
+	requestTimeoutMs: z.number().int().min(1).max(600000).default(60000)
+}).strict().superRefine((model, ctx) => {
+	if (!model.apiKey && !model.apiKeyEnv) ctx.addIssue({ code: "custom", message: "Set model.apiKeyEnv or model.apiKey" });
+	if (!model.baseURL) {
+		const result = StagehandClientCreateConfigSchema.safeParse({
+			model: { modelName: model.modelName, apiKey: model.apiKey ?? "credential-reference", headers: model.headers }
+		});
+		if (!result.success) ctx.addIssue({ code: "custom", message: "Non-catalog model requires an explicit Anthropic baseURL" });
+	}
+});
+
+export function messagesURL(baseURL) {
+	const url = new URL(baseURL);
+	url.pathname = url.pathname.replace(/\/+$/, "");
+	if (!url.pathname.endsWith("/messages")) url.pathname += url.pathname.endsWith("/v1") ? "/messages" : "/v1/messages";
+	return url.href;
+}
+
+function contentBlock(block) {
+	switch (block.type) {
+		case "text": return { type: "text", text: block.text };
+		case "image": return { type: "image", source: { type: "base64", media_type: block.mimeType, data: block.data } };
+		case "tool_use": return { type: "tool_use", id: block.id, name: block.name, input: block.input };
+		case "tool_result": return {
+			type: "tool_result", tool_use_id: block.toolUseId,
+			content: block.content.map(contentBlock), ...(block.isError === undefined ? {} : { is_error: block.isError })
+		};
+		default: throw new Error(`Unsupported Stagehand message block: ${block.type}`);
+	}
+}
+
+export function anthropicRequest(model, params) {
+	const structured = params.responseFormat?.type === "json_schema";
+	const body = {
+		model: model.modelName,
+		max_tokens: model.maxTokens,
+		stream: false,
+		thinking: { type: "disabled" },
+		messages: params.messages.map((message) => ({
+			role: message.role,
+			content: (Array.isArray(message.content) ? message.content : [message.content]).map(contentBlock)
+		}))
+	};
+	if (params.systemPrompt !== undefined) body.system = params.systemPrompt;
+	if (params.temperature !== undefined) body.temperature = params.temperature;
+	if (params.stopSequences !== undefined) body.stop_sequences = params.stopSequences;
+	if (structured) {
+		body.tools = [{
+			name: "stagehand_result",
+			description: params.responseFormat.description ?? "Return the requested structured result.",
+			input_schema: {
+				type: "object", properties: { result: params.responseFormat.schema },
+				required: ["result"], additionalProperties: false
+			}
+		}];
+		body.tool_choice = { type: "tool", name: "stagehand_result" };
+	} else if (params.tools?.length) {
+		body.tools = params.tools.map((tool) => ({
+			name: tool.name, ...(tool.description === undefined ? {} : { description: tool.description }),
+			input_schema: tool.inputSchema
+		}));
+		const choice = params.toolChoice?.mode;
+		body.tool_choice = { type: choice === "required" ? "any" : choice ?? "auto" };
+	}
+	return body;
+}
+
+export function anthropicResult(response, params) {
+	if (response.type !== "message" || response.role !== "assistant" || !Array.isArray(response.content))
+		throw new Error("Anthropic route returned an invalid message");
+	if (response.stop_reason === "max_tokens") throw new Error("Stagehand model output reached maxTokens; response rejected as incomplete");
+	const content = response.content.filter((block) => ["text", "tool_use"].includes(block.type)).map((block) =>
+		block.type === "text" ? { type: "text", text: block.text } :
+			{ type: "tool_use", id: block.id, name: block.name, input: block.input });
+	const result = { role: "assistant", content, outputFormat: "text" };
+	if (response.stop_reason) result.stopReason = response.stop_reason;
+	if (response.usage) {
+		const usage = response.usage;
+		const input = (usage.input_tokens ?? 0) + (usage.cache_read_input_tokens ?? 0) + (usage.cache_creation_input_tokens ?? 0);
+		const output = usage.output_tokens ?? 0;
+		result.usage = { inputTokens: input, outputTokens: output, totalTokens: input + output,
+			...(usage.cache_read_input_tokens === undefined ? {} : { cachedInputTokens: usage.cache_read_input_tokens }) };
+	}
+	if (params.responseFormat?.type === "json_schema") {
+		const blocks = content.filter((block) => block.type === "tool_use" && block.name === "stagehand_result");
+		if (blocks.length !== 1 || !Object.hasOwn(blocks[0].input, "result"))
+			throw new Error("Anthropic route did not return the required structured tool result");
+		const structuredContent = z.fromJSONSchema(params.responseFormat.schema).parse(blocks[0].input.result);
+		result.outputFormat = "json_schema";
+		result.structuredContent = structuredContent;
+		result.content = [{ type: "text", text: JSON.stringify(structuredContent) }];
+	}
+	if (result.content.length === 0) throw new Error("Anthropic route returned no usable output");
+	return result;
+}
+
+export function createAnthropicModel(model, fetchImpl = fetch) {
+	if (!model.apiKey?.trim()) throw new Error("Stagehand model credential is unavailable");
+	return {
+		async generate(params) {
+			const headers = new Headers(model.headers);
+			headers.set("content-type", "application/json");
+			headers.set("anthropic-version", "2023-06-01");
+			headers.set("x-api-key", model.apiKey);
+			let response;
+			try {
+				response = await fetchImpl(messagesURL(model.baseURL), {
+					method: "POST", headers, redirect: "error",
+					body: JSON.stringify(anthropicRequest(model, params)),
+					signal: AbortSignal.timeout(model.requestTimeoutMs)
+				});
+			} catch {
+				throw new Error("Stagehand Anthropic request failed or timed out; no automatic retry");
+			}
+			if (!response.ok) {
+				await response.body?.cancel();
+				throw new Error(`Stagehand Anthropic HTTP ${response.status}; check configured route/credential/quota; no automatic retry`);
+			}
+			let body;
+			try { body = await response.json(); } catch { throw new Error("Stagehand Anthropic response was not JSON"); }
+			return anthropicResult(body, params);
+		}
+	};
+}
